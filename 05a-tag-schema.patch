diff --git a/server/utils/tag-taxonomy.test.ts b/server/utils/tag-taxonomy.test.ts
new file mode 100644
index 0000000..3d7af91
--- /dev/null
+++ b/server/utils/tag-taxonomy.test.ts
@@ -0,0 +1,74 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+// The generated Prisma client doesn't exist until `prisma generate` runs
+// against a live engine. Mock it at the module boundary so this test only
+// exercises the seeding logic (what gets created vs skipped), not Prisma
+// itself. Prisma enums compile down to plain string-keyed objects, so a
+// plain object is a faithful stand-in for TagCategory here.
+vi.mock('../../prisma/generated/client', () => ({
+  TagCategory: { PERSONALITY: 'PERSONALITY', EXPERTISE: 'EXPERTISE' },
+}))
+
+import { ensureDefaultTags } from './tag-taxonomy'
+
+function makePrismaMock(existingNames: Set<string>) {
+  return {
+    tag: {
+      findUnique: vi.fn(({ where }: { where: { name_category: { name: string } } }) =>
+        existingNames.has(where.name_category.name) ? { id: 'x' } : null,
+      ),
+      create: vi.fn(),
+    },
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  } as any
+}
+
+describe('ensureDefaultTags', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('creates every default tag when none exist yet', async () => {
+    const prisma = makePrismaMock(new Set())
+    await ensureDefaultTags(prisma)
+
+    expect(prisma.tag.create).toHaveBeenCalled()
+    const createdNames = prisma.tag.create.mock.calls.map(
+      (call: [{ data: { name: string } }]) => call[0].data.name,
+    )
+    expect(createdNames).toContain('Trauma-informed care')
+    expect(createdNames).toContain('Warm and nurturing')
+  })
+
+  it('is idempotent: skips tags that already exist', async () => {
+    const prisma = makePrismaMock(new Set(['Trauma-informed care']))
+    await ensureDefaultTags(prisma)
+
+    const createdNames = prisma.tag.create.mock.calls.map(
+      (call: [{ data: { name: string } }]) => call[0].data.name,
+    )
+    expect(createdNames).not.toContain('Trauma-informed care')
+    expect(createdNames).toContain('Warm and nurturing')
+  })
+
+  it('creates nothing when every default tag already exists', async () => {
+    const allNames = new Set([
+      'Warm and nurturing',
+      'Direct communicator',
+      'Structured / goal-oriented',
+      'Calm and patient',
+      'High energy / playful',
+      'Trauma-informed care',
+      'Anxiety',
+      'Depression',
+      'Child & adolescent therapy',
+      'Family systems',
+      'Grief and loss',
+      'Substance use',
+    ])
+    const prisma = makePrismaMock(allNames)
+    await ensureDefaultTags(prisma)
+
+    expect(prisma.tag.create).not.toHaveBeenCalled()
+  })
+})
diff --git a/server/utils/tag-taxonomy.ts b/server/utils/tag-taxonomy.ts
new file mode 100644
index 0000000..c0410d5
--- /dev/null
+++ b/server/utils/tag-taxonomy.ts
@@ -0,0 +1,49 @@
+import type { PrismaClient } from '../../prisma/generated/client'
+import { TagCategory } from '../../prisma/generated/client'
+
+/**
+ * Starter tag vocabulary for clinician-client matching (REQ-F-05).
+ *
+ * This is a first-pass list, not a clinical standard — expect it to be
+ * edited through the tag management UI (REQ-F-05a.2) once that exists.
+ * Keeping it here (rather than only in migration SQL) makes it visible in
+ * code review and easy to extend.
+ */
+const DEFAULT_PERSONALITY_TAGS = [
+  'Warm and nurturing',
+  'Direct communicator',
+  'Structured / goal-oriented',
+  'Calm and patient',
+  'High energy / playful',
+]
+
+const DEFAULT_EXPERTISE_TAGS = [
+  'Trauma-informed care',
+  'Anxiety',
+  'Depression',
+  'Child & adolescent therapy',
+  'Family systems',
+  'Grief and loss',
+  'Substance use',
+]
+
+/**
+ * Ensures the default tag vocabulary exists. Idempotent — matches existing
+ * tags by (name, category) and only creates what's missing, so it's safe to
+ * run on every deploy alongside the other reference-data seeders.
+ */
+export async function ensureDefaultTags(prisma: PrismaClient): Promise<void> {
+  const seedList: { name: string; category: TagCategory }[] = [
+    ...DEFAULT_PERSONALITY_TAGS.map((name) => ({ name, category: TagCategory.PERSONALITY })),
+    ...DEFAULT_EXPERTISE_TAGS.map((name) => ({ name, category: TagCategory.EXPERTISE })),
+  ]
+
+  for (const { name, category } of seedList) {
+    const existing = await prisma.tag.findUnique({
+      where: { name_category: { name, category } },
+    })
+    if (!existing) {
+      await prisma.tag.create({ data: { name, category } })
+    }
+  }
+}
