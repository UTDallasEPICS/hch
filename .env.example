DATABASE_URL=file:./dev.db

# Port the app server listens on, for both dev and production. Defaults to 3000.
PORT=3000

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=
# Dev prints the OTP to the terminal by default. Set to true (with EMAIL_USER/EMAIL_PASS
# above) only if you want to test real SMTP sending locally.
EMAIL_OTP_USE_SMTP=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
