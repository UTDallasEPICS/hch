enum ClientStatus {
  INCOMPLETE
  WAITLIST
  ACTIVE
  ARCHIVED
}

model Client {
  id                   String                @id @default(cuid())
  userId               String                @unique
  status               ClientStatus          @default(INCOMPLETE)
  therapyWeek          Int? // 0-26, max weeks of therapy
  missedSessions       Int                   @default(0) // count of missed therapy sessions
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions          ClientPermission?
  sessionNotes         SessionNote[]
  plan                 ClientPlan?
  sessionNotesRequests SessionNotesRequest[]

  @@index([status])
  @@map("client")
}

// Controls what clients can see on their dashboard
model ClientPermission {
  id            String  @id @default(cuid())
  clientId      String  @unique
  canViewScores Boolean @default(false)
  canViewNotes  Boolean @default(false)
  canViewPlan   Boolean @default(false)
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_permission")
}

model ClientPlan {
  id        String   @id @default(cuid())
  clientId  String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_plan")
}

// Audit trail for changes requiring reasoning + documentation + admin signature
model ChangeAudit {
  id                String   @id @default(cuid())
  entityType        String // 'ABSENCE' | 'TREATMENT_PLAN' | etc.
  entityId          String // client userId or clientId
  oldValue          String? // JSON
  newValue          String? // JSON
  reasoning         String?
  documentationPath String? // Path to uploaded PDF/Word file (optional)
  documentationName String? // Original filename for display
  signatureData     String // base64 PNG of signature
  signedById        String
  signedAt          DateTime @default(now())
  signedBy          User     @relation(fields: [signedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("change_audit")
}
