enum SessionNotesRequestKind {
  FULL
  SUMMARY
}

enum SessionNotesRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Multi-tier approval status for a session note.
/// DRAFT = work-in-progress, only clinician can see.
/// CLINICIAN_SIGNED = clinician has signed; awaits admin sign-off.
/// FULLY_APPROVED = admin has countersigned; note is final.
enum SessionNoteStatus {
  DRAFT
  CLINICIAN_SIGNED
  FULLY_APPROVED
}

/// Regulatory separation: progress notes are part of the clinical record;
/// psychotherapy notes (aka "process notes") are stored separately and
/// protected more strictly under HIPAA.
enum SessionNoteKind {
  PROGRESS
  PSYCHOTHERAPY
}

model SessionNote {
  id            String            @id @default(cuid())
  clientId      String
  sessionName   String
  sessionNumber Int
  appointmentId String?
  kind          SessionNoteKind   @default(PROGRESS)
  status        SessionNoteStatus @default(DRAFT)
  content       String
  attended      Boolean           @default(true)
  /// Deprecated: legacy single-signature field kept for back-compat with existing rows.
  /// New flow uses `clinicianSignatureData` / `adminSignatureData` below.
  signatureData String?

  /// Tier 1 — signed by the clinician who wrote the note.
  clinicianSignedAt      DateTime?
  clinicianSignedById    String?
  clinicianSignatureData String?

  /// Tier 2 — admin counter-sign.
  adminSignedAt      DateTime?
  adminSignedById    String?
  adminSignatureData String?
  adminApprovalNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment     Appointment?      @relation("AppointmentSessionNotes", fields: [appointmentId], references: [id], onDelete: SetNull)
  clinicianSigner User?             @relation("ClinicianSignedNotes", fields: [clinicianSignedById], references: [id], onDelete: SetNull)
  adminSigner     User?             @relation("AdminSignedNotes", fields: [adminSignedById], references: [id], onDelete: SetNull)
  edits           SessionNoteEdit[]
  notifications   Notification[]

  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([kind])
  @@map("session_note")
}

model SessionNoteEdit {
  id              String      @id @default(cuid())
  sessionNoteId   String
  originalContent String?
  reason          String?
  signature       String?
  editedAt        DateTime    @default(now())
  sessionNote     SessionNote @relation(fields: [sessionNoteId], references: [id], onDelete: Cascade)

  @@index([sessionNoteId])
  @@map("session_note_edit")
}

enum NotificationType {
  NOTE_READY_FOR_APPROVAL
  NOTE_FULLY_APPROVED
  NOTE_EDITED_AFTER_APPROVAL
}

/// In-app notifications (e.g. admins are notified whenever a clinician signs a note).
model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  sessionNoteId String?
  sessionNote   SessionNote?     @relation(fields: [sessionNoteId], references: [id], onDelete: Cascade)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

// Canonical declaration copy per request kind + version (avoids duplicating long text on every request).
model DeclarationTemplate {
  id                   String                  @id @default(cuid())
  requestKind          SessionNotesRequestKind
  version              Int
  content              String
  createdAt            DateTime                @default(now())
  sessionNotesRequests SessionNotesRequest[]

  @@unique([requestKind, version])
  @@map("declaration_template")
}

// Client records requests (formerly "session notes request"): full notes or a summary.
// Requires admin approval + signature. Optional date-range scopes the export window.
model SessionNotesRequest {
  id                    String                    @id @default(cuid())
  clientId              String
  client                Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestKind           SessionNotesRequestKind
  status                SessionNotesRequestStatus @default(PENDING)
  signatureData         String // base64 PNG
  declarationTemplateId String
  declarationTemplate   DeclarationTemplate       @relation(fields: [declarationTemplateId], references: [id], onDelete: Restrict)
  /// Optional requested-range start (inclusive). Null = no lower bound / all records.
  startDate             DateTime?
  /// Optional requested-range end (inclusive). Null = no upper bound / all records.
  endDate               DateTime?
  createdAt             DateTime                  @default(now())
  decidedAt             DateTime?
  decidedByUserId       String?
  decidedBy             User?                     @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  /// Free-text justification entered by admin when approving (required).
  approvalReason        String?
  rejectionReason       String?
  approvedSummaryText   String? // required when approving SUMMARY; shown to client instead of raw notes

  @@index([clientId])
  @@index([status])
  @@index([declarationTemplateId])
  @@map("session_notes_request")
}
